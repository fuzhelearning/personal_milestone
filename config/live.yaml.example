# 线上配置模板：cp config/live.yaml.example config/live.yaml 并改真实值
# config/live.yaml 勿提交仓库
# 启动：APP_ENV=live uvicorn main:app --host 0.0.0.0 --port 8000

app_env: live
# 与 personal_db 容器一致：root + MYSQL_ROOT_PASSWORD
database_url: mysql+pymysql://root:YOUR_ROOT_PASSWORD@127.0.0.1:3306/personal_milestone
jwt_secret: replace-with-long-random-secret
jwt_expire_seconds: 7200
llm_mode: mock
# 真模型时改为 deepseek，并填写下列字段（勿提交真实 key）
llm_api_key: ""
llm_base_url: ""
llm_model: ""
internal_token: replace-with-long-random-internal-token
wechat_mock: false
celery_broker_url: amqp://guest:guest@127.0.0.1:5672//
celery_result_backend: ""
celery_task_always_eager: false
enable_docs: false
cors_origins:
  - https://personallearnf.com.cn
