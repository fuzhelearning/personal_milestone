{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-milestone.local/schemas/wbs_generate.schema.json",
  "title": "WbsGenerateOutput",
  "type": "object",
  "additionalProperties": false,
  "required": ["milestones", "day_assignments"],
  "properties": {
    "milestones": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "title", "start_date", "end_date", "tasks"],
        "properties": {
          "code": { "type": "string", "pattern": "^[0-9]+\\.0$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "start_date": { "type": "string", "format": "date" },
          "end_date": { "type": "string", "format": "date" },
          "tasks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 40,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "title", "start_date", "end_date"],
              "properties": {
                "code": { "type": "string", "minLength": 1, "maxLength": 32 },
                "title": { "type": "string", "minLength": 1, "maxLength": 200 },
                "description": { "type": "string", "maxLength": 2000 },
                "start_date": { "type": "string", "format": "date" },
                "end_date": { "type": "string", "format": "date" },
                "depends_on": {
                  "type": "array",
                  "items": { "type": "string" },
                  "maxItems": 20
                }
              }
            }
          }
        }
      }
    },
    "day_assignments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "task_codes"],
        "properties": {
          "date": { "type": "string", "format": "date" },
          "task_codes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": { "type": "string" },
            "description": "AI 初排：一天一事；顺延叠加见 ADR-0015（不在本 schema）"
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 20
    },
    "risks": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 20
    },
    "suggested_deadline_change": {
      "type": ["string", "null"],
      "format": "date"
    }
  }
}
