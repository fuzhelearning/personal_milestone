{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-milestone.local/schemas/day_assignments_replan.schema.json",
  "title": "DayAssignmentsReplanOutput",
  "description": "周日重排 / 周内顺延（AI 路径）。禁止删除已确认 WBS 节点；仅调整 day_assignments；可选建议改期。",
  "type": "object",
  "additionalProperties": false,
  "required": ["day_assignments"],
  "properties": {
    "day_assignments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "task_ids"],
        "properties": {
          "date": { "type": "string", "format": "date" },
          "task_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": { "type": "integer", "minimum": 1 },
            "description": "可同日多条（含顺延叠加）；AI 初排仍宜少排"
          }
        }
      }
    },
    "rationale": { "type": "string", "maxLength": 2000 },
    "suggested_deadline_change": {
      "type": ["string", "null"],
      "format": "date"
    }
  }
}
